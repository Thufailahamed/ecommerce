{
  "name": "convertflow-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://convertflow-api.thufailahamed627.workers.dev",
    "NEXT_PUBLIC_SDK_URL": "https://convertflow-sdk.thufailahamed627.workers.dev"
  }
}
