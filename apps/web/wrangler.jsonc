{
  // NEXT_PUBLIC_* values are baked into the build (`cf:build`); the vars below only document the development deployment.
  "name": "convertflow-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://convertflow-api.thufailahamed627.workers.dev",
    "NEXT_PUBLIC_SDK_URL": "https://convertflow-sdk.thufailahamed627.workers.dev"
  },
  "env": {
    "staging": {
      "name": "convertflow-web-staging",
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "vars": { "NEXT_PUBLIC_API_URL": "https://api-staging.example.com", "NEXT_PUBLIC_SDK_URL": "https://sdk-staging.example.com" }
    },
    "production": {
      "name": "convertflow-web-production",
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "vars": { "NEXT_PUBLIC_API_URL": "https://api.example.com", "NEXT_PUBLIC_SDK_URL": "https://sdk.example.com" }
    }
  }
}
